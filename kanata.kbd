(defcfg
  concurrent-tap-hold yes
  process-unmapped-keys yes
)

(defsrc
   caps \
   q    w    e    r    t    y    u    i    o    p
   a    s    d    f    g    h    j    k    l    ;
   z    x    c    v    b    n    m    ,    .    /
                       spc         
)

(defalias

  ;; Layer switches
  sw_layer1 (layer-while-held layer_1)


  hs (tap-hold 150 250 s lmeta)
  hh (tap-hold 150 250 h lalt)
  hn (tap-hold 150 250 n lctl)
  ht (tap-hold 150 250 t lsft)
  ha (tap-hold 150 250 a rsft)
  he (tap-hold 150 250 e rctl)
  ho (tap-hold 150 250 o ralt)
  hi (tap-hold 150 250 i rmeta)

  ;; Symbols
  lb [
  rb ]
  lc S-[
  rc S-]
  rp (tap-hold 150 250 S-0 lsft)
  lp (tap-hold 150 250 S-9 lctl)
  gt (tap-hold 150 250 S-. lalt)
  lt (tap-hold 150 250 S-, lmeta)
  semi ;
  colon S-;
  comma ,
  dot .
  slash /
  eq =
  plus S-=
  minus -
  undsco S--
  ast S-8
  amp S-7
  excl S-1
  quest S-/
  at S-2
  hash S-3
  bkslash \
  or S-\
  pgup_ (tap-hold 150 250 pgup home)
  pgdn_ (tap-hold 150 250 pgdn end)
)

(deflayer halmak
 @sw_layer1 caps
   w    l    r    b    z    ;    q    u    d    j
   @hs  @hh  @hn  @ht  ,    .    @ha  @he  @ho  @hi
   f    m    v    c    /    g    p    x    k    y
                       spc
)

(deflayer layer_1
 _    caps
   [    ]    @lc  @rc  _    @amp @ast up   @bkslash @or
   @lt  @gt  @lp  @rp  _    @eq  left down right bspc
   del  @hash @at  @excl esc  @plus @minus @undsco @pgup_ @pgdn_
                       ret
)