(defcfg
  concurrent-tap-hold yes
  process-unmapped-keys yes
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ───────────────────────────────────────────────────────────
;;  ALIASES
;; ───────────────────────────────────────────────────────────
(defalias
  ;; ` (grave): tap = grave accent, hold = momentary QWERTY layer
  grl (tap-hold 200 200 grv (layer-toggle qwerty))

  ;; Layer switches
  sw_layer1 (layer-while-held layer_1)

  ;; Symbols
  lb [
  rb ]
  lc S-[
  rc S-]
  rp (tap-hold 150 250 S-0 lsft)
  lp (tap-hold 150 250 S-9 lctl)
  gt (tap-hold 150 250 S-. lalt)
  lt (tap-hold 150 250 S-, lmeta)
  semi ;
  colon S-;
  comma ,
  dot .
  slash /
  eq =
  plus S-=
  minus -
  undsco S--
  ast S-8
  amp S-7
  excl S-1
  quest S-/
  at S-2
  hash S-3
  bkslash \
  or S-\
  pgup_ (tap-hold 150 250 pgup home)
  pgdn_ (tap-hold 150 250 pgdn end)
)

;; ───────────────────────────────────────────────────────────
;;  DEFAULT LAYER: HALMAK
;; ───────────────────────────────────────────────────────────
(deflayer halmak
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab        w    l    r    b    z    ;    q    u    d    j    [    ]    \
  @sw_layer1 s    h    n    t    ,    .    a    e    o    i    '    ret
  lsft       f    m    v    c    /    g    p    x    k    y    rsft
  lctl       lmet lalt           spc            ralt rmet rctl
)

;; ───────────────────────────────────────────────────────────
;;  MOMENTARY LAYER: QWERTY (active while ` is held)
;; ───────────────────────────────────────────────────────────
(deflayer qwerty
  grv        1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab        q    w    e    r    t    y    u    i    o    p    [    ]    \
  @sw_layer1 a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft       z    x    c    v    b    n    m    ,    .    /    rsft
  lctl       lmet lalt           spc            ralt rmet rctl
)

;; ───────────────────────────────────────────────────────────
;;  SYMBOL & NAVIGATION LAYER (hold CapsLock)
;; ───────────────────────────────────────────────────────────
(deflayer layer_1
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    [    ]    @lc  @rc  _    @amp @ast up   @bkslash @or _    _    caps
  _    @lt  @gt  @lp  @rp  _    @eq  left down right bspc '    ret
  _    del  @hash @at  @excl esc @plus @minus @undsco @pgup_ @pgdn_ _
  _    _    _              ret            _    _    _
)
