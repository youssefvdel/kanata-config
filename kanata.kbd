;; Qwerty Configuration

(defcfg
  concurrent-tap-hold yes
  process-unmapped-keys yes
)

(defsrc
  caps  \     ins
  q     w     e     r     t     y     u     i     o     p
  a     s     d     f     g     h     j     k     l     ;
  z     x     c     v     b     n     m     ,     .     /
                         spc
)

(defvar
  ;; Timing for tap-hold dual-role keys (in milliseconds)
  tap-time  150
  hold-time 250
)

(defalias
  ;; --- Layer Toggles ---
  nav-sym    (layer-while-held nav-sym)
  tog-bypass (layer-switch bypass)  ;; Turns Kanata OFF (normal keyboard)
  tog-base   (layer-switch base)    ;; Turns Kanata ON

  ;; --- Home Row Mods (Base Layer) ---
  ;; Format: <tap-key>-<held-modifier>
  a-met   (tap-hold $tap-time $hold-time a lmeta)
  s-alt   (tap-hold $tap-time $hold-time s lalt)
  d-ctl   (tap-hold $tap-time $hold-time d lctl)
  f-sft   (tap-hold $tap-time $hold-time f lsft)
  j-sft   (tap-hold $tap-time $hold-time j rsft)
  k-ctl   (tap-hold $tap-time $hold-time k rctl)
  l-alt   (tap-hold $tap-time $hold-time l ralt)
  scl-met (tap-hold $tap-time $hold-time ; rmeta)

  ;; --- Dual-Role Modifiers on Nav/Sym Layer (Mirrors Base Layer HRM) ---
  lt-met  (tap-hold $tap-time $hold-time S-, lmeta)
  gt-alt  (tap-hold $tap-time $hold-time S-. lalt)
  lp-ctl  (tap-hold $tap-time $hold-time S-9 lctl)
  rp-sft  (tap-hold $tap-time $hold-time S-0 lsft)

  ;; --- Dual-Role Navigation ---
  pgup-home (tap-hold $tap-time $hold-time pgup home)
  pgdn-end  (tap-hold $tap-time $hold-time pgdn end)

  ;; --- Symbols ---
  lbrace S-[   ;; {
  rbrace S-]   ;; }
  amp    S-7   ;; &
  ast    S-8   ;; *
  bsls   \     ;; \
  pipe   S-\   ;; |
  eq     =     ;; =
  hash   S-3   ;; #
  at     S-2   ;; @
  excl   S-1   ;; !
  plus   S-=   ;; +
  minus  -     ;; -
  under  S--   ;; _
  qmk    S-/   ;; ?
)

(deflayer base
  @nav-sym caps  @tog-bypass
  _     _     _     _     _     _     _     _     _     _
  @a-met @s-alt @d-ctl @f-sft _     _     @j-sft @k-ctl @l-alt @scl-met
  _     _     _     _     _     _     _     _     _     _
                         _
)

(deflayer nav-sym
  _     caps  @tog-bypass
  [     ]     @lbrace @rbrace _     @amp  @ast  up    @bsls @pipe
  @lt-met @gt-alt @lp-ctl @rp-sft _     @eq   left  down  right bspc
  del   @hash @at   @excl esc   @plus @minus @under @pgup-home @pgdn-end
                         @qmk
)

;; Bypass / Gaming layer: All keys are raw standard keys (no HRM / no delays)
(deflayer bypass
  _     _     @tog-base
  _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _
                         _
)
